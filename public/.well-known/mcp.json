{
  "name": "modasmelomerezco-mcp",
  "displayName": "Modas Me lo Merezco — MCP Server",
  "description": "Servidor y herramientas de consulta del catálogo de productos, categorías y políticas de compra de Modas Me lo Merezco.",
  "version": "1.0.0",
  "homepage": "https://www.modasmelomerezco.es/",
  "documentationUrl": "https://www.modasmelomerezco.es/llms.txt",
  "provider": {
    "name": "Modas Me lo Merezco",
    "url": "https://www.modasmelomerezco.es/"
  },
  "endpoints": {
    "chat": "https://www.modasmelomerezco.es/api/chat",
    "sitemap": "https://www.modasmelomerezco.es/sitemap.xml"
  },
  "capabilities": {
    "tools": true,
    "resources": true,
    "prompts": false
  },
  "tools": [
    {
      "name": "chat_assistant",
      "description": "Consulta al asistente virtual MeloMe sobre productos, tallas, colores, precios y políticas de la tienda.",
      "inputSchema": {
        "type": "object",
        "required": ["action", "messages"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["chat", "embed"]
          },
          "systemPrompt": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["role", "content"],
              "properties": {
                "role": { "type": "string", "enum": ["user", "assistant"] },
                "content": { "type": "string" }
              }
            }
          }
        }
      }
    }
  ]
}
